{
  "name": "cadflux",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/backend.integration.test.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "db:setup": "node --env-file=.env scripts/setup-database.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "6.19.3",
    "zod": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "exceljs": "^4.4.0",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.7.0",
    "vitest": "^4.0.0",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.58.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.16.0"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "pnpm": { "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp", "esbuild", "embedded-postgres", "@embedded-postgres/windows-x64", "@embedded-postgres/linux-x64", "@embedded-postgres/darwin-arm64", "@tailwindcss/oxide"] }
}
